Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

{
    "idCarga": "1",
    "cidadeDestino": "Florianopolis",
    "status": "TRANSITO",
    "data": "2026-10-25",
    "hora": "14:00:00"
}

